# Copy this file to `.env` and fill in your key. Never commit `.env`.

# --- Option A (default, free): Google Gemini via its OpenAI-compatible endpoint
# Get a free key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.5-flash-lite
# Router uses a different model so it has its own free-tier quota (15 requests/min each)
ROUTER_MODEL=gemini-flash-lite-latest

# --- Option B: Groq (free tier, very fast; key at https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
# ROUTER_MODEL=llama-3.1-8b-instant

# --- Option B2: OpenRouter (pick a free model that supports "tools")
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<model-id>:free

# --- Option C: local model on your GPU with Ollama (`ollama pull qwen3:8b`)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# --- Agent switches
ROUTER_MODE=llm            # llm | heuristic
ENABLE_REFLECTION=true

# --- Optional phone notifications for leads/feedback (https://pushover.net)
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
